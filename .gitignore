.venv/
.venv310/
.pytest_cache/
.vscode/
.env
*.pyc
__pycache__/

# Ingested data (re-ingestible; use STORAGE_BACKEND=mongodb to persist externally)
data/indexes/
data/uploads/
data/doc_trees/
data/derived_markdown/
data/model_registry.json
data/traces

# Experiments harness source should stay tracked; generated artifacts should not.
experiments/artifacts/*
!experiments/
!experiments/**/*.py
!experiments/**/*.md
!experiments/**/.gitkeep

# Keep placeholder files so empty directories stay tracked
!**/.gitkeep
