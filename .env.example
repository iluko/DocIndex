# Storage backend: "local" (default) or "mongodb"
STORAGE_BACKEND=local

# MongoDB (only needed when STORAGE_BACKEND=mongodb)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=hybrid_approach

LLM_PROVIDER=azure
LLM_MODEL=your-chat-deployment-name

# Optional: human-readable name for your knowledge base / domain.
# When set, the answer LLM introduces itself as an expert for this domain.
# Leave blank for the generic "knowledgeable assistant" introduction.
# Examples: "Acme Legal Knowledge Base", "Product Engineering Docs", "HR Policy Hub"
DOMAIN_NAME=

# Retrieval mode: "hybrid" (default) or "pageindex"
#   hybrid    — deterministic pipeline: router → navigator → verifier → fetcher → answer
#   pageindex — agentic tool-use loop: LLM calls get_document_structure /
#               get_node_content iteratively until it can answer
RETRIEVAL_MODE=hybrid

# Navigator self-correction pass (hybrid mode only).
# When true, a second LLM call per selected document verifies that each
# navigator-selected section actually addresses the query. Sections that fail
# are dropped before fetching. Adds ~1 LLM call per selected document.
# Default: false (disabled) — enable for higher precision at the cost of latency.
NAVIGATOR_VERIFICATION=false

# PageIndex still reads CHATGPT_API_KEY. The app will auto-fill it from Azure if omitted,
# but setting it explicitly keeps PageIndex-compatible tooling predictable.
CHATGPT_API_KEY=

# OpenAI mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-11-20

# Azure OpenAI v1 mode
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
# Optional. If omitted, the app derives it from AZURE_OPENAI_ENDPOINT.
AZURE_OPENAI_BASE_URL=https://your-resource-name.openai.azure.com/openai/v1/
# For Azure, use your deployment name here if LLM_MODEL is not set.
AZURE_OPENAI_CHAT_DEPLOYMENT=

# Ingestion-only: target number of master-node top sections. Prompt range becomes
# target-1 to target+1. Higher values improve routing detail but increase master-tree prompt size.
MASTER_TOP_SECTIONS_TARGET=4
